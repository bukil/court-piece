rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Public room documents
    match /rooms/{roomId} {
      // Any authenticated user can read public room state (lobby, seats, scores, trick)
      allow read: if isAuthenticated();

      // Only authenticated users can create a room, designating themselves as the initial host
      allow create: if isAuthenticated() && request.resource.data.hostPlayerId == request.auth.uid;

      // Authenticated users can update room state (claiming a seat, playing a card, syncing state)
      allow update: if isAuthenticated();

      // Disallow client-side deletion to protect match persistence
      allow delete: if false;

      // Private Hands: STRICT SECURITY INVARIANT
      // A player can ONLY ever read their own hand. Opponents and teammates CANNOT read other hands.
      match /privateHands/{playerId} {
        // Read is strictly restricted to the hand owner whose UID matches the document ID
        allow read: if isAuthenticated() && request.auth.uid == playerId;

        // Writes are allowed for authenticated players (dealing cards, updating hand on card play)
        allow write: if isAuthenticated();
      }

      // Server Data (Stores the 32-card reserve deck during trump selection phase)
      match /serverData/{docId} {
        allow read, write: if isAuthenticated();
      }
    }
  }
}
